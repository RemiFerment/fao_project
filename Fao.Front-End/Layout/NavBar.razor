@inherits LayoutComponentBase
@inject NavigationManager NavigationManager
@using Fao.Front_End.Layout.NavBars.Coach
@using Fao.Front_End.Layout.NavBars.User
@using Microsoft.AspNetCore.Components.Authorization

<AuthorizeView Roles="ROLE_USER">
    <Authorized>
        <NavBarUser />
    </Authorized>
    <NotAuthorized>
    </NotAuthorized>
</AuthorizeView>
<AuthorizeView Roles="ROLE_COACH">
    <Authorized>
        <NavBarCoach />
    </Authorized>
    <NotAuthorized>
    </NotAuthorized>
</AuthorizeView>

@code {

    protected override void OnInitialized()
    {
        NavigationManager.LocationChanged += (_, __) => StateHasChanged();
    }

    private string GetNavLinkClass(string href)
    {
        var relativeUri = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        return relativeUri.Contains(href.TrimStart('/'), StringComparison.OrdinalIgnoreCase)
        ? "navButtonActive"
        : string.Empty;
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= (_, __) => StateHasChanged();
    }
}