@using Fao.Front_End.Components.Partials
@using Fao.Front_End.Layout.NavBars.Coach
@using Fao.Front_End.Models
@using Fao.Front_End.Services
@inherits LayoutComponentBase
<div class="page">
    <nav>
        <NavBar />
    </nav>
    <ConfirmModal @ref="_confirmModal" />
    <CascadingValue Value="this">
        <main class="flex-grow-1 d-flex flex-column min-vh-100">
            <article class="content flex-grow-1 d-flex flex-column px-md-0 px-0 py-0">
                @Body
            </article>
            <div id="blank"></div>
        </main>
    </CascadingValue>
</div>

@code {
    private ConfirmModal? _confirmModal;
    private UserDTO? _currentUser;
    [Inject] public UserServices UserServices { get; set; } = default!;
    [Inject] public NavigationManager NavigationManager { get; set; } = default!;

    public async Task ShowConfirm(
    EventCallback onConfirm,
    string title = "Confirmation",
    string message = "Êtes-vous sûr ?")
    {
        if (_confirmModal is not null)
        {
            await _confirmModal.Display(onConfirm, title, message);
        }
    }
    protected override async Task OnInitializedAsync()
    {
        if (!NavigationManager.Uri.Contains("login"))
            _currentUser = await UserServices.GetUserInfoAsync();
    }
}