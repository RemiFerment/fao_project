@using Fao.Front_End.Models
@using Fao.Front_End.Services
<div class="p-2 mb-4 customers-card rounded">
    <div class="d-flex justify-content-around">
        <div class="d-flex flex-column">
            <small class="text-muted">Identité :</small>
            <a class="fs-4 fs-md-6 mb-2" href="@($"customer/{User.Uuid}")">@User.GetIdentity()</a>
        </div>
        <div class="d-flex flex-column">
            <small class="text-muted">Sexe :</small>
            <div><span class="badge bg-secondary fs-6">@User.GetGenderShort()</span></div>
        </div>
        <div class="col-md-3 d-none d-md-block">
            <small class="text-muted">E-mail :</small>
            <h2 class="fs-5 text-muted mb-2"><a href="mailto:@User.Email">@User.Email</a></h2>
        </div>
        <div class="col-md-4 d-none d-md-block">
            <small class="text-muted">Date de naissance :</small>
            <div><small class="text-muted">@User.GetFormattedBirthDate() (@User.GetAge() ans)</small></div>
        </div>
    </div>
</div>

@code {
    [Parameter] public UserDTO User { get; set; } = new UserDTO();
}