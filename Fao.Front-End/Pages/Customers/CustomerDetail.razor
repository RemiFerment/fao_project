@page "/customer/{CustomerUUID:guid}"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@attribute [Authorize(Roles = "ROLE_COACH")]

@if (IsLoading)
{
    <div class="text-center my-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}
else if (Customer == null)
{
    <div class="d-flex gap-4 justify-content-center my-4">
        <i class="bi bi-arrow-left-circle fs-1 text-danger cursor-pointer" @onclick="@NavigateBack"></i>
    </div>
    <div class="alert alert-danger" role="alert">
        Un problème est survenu lors du chargement des informations du client. Vérifier le lien ou réessayer plus tard.
    </div>
}
else
{
    <i class="bi bi-arrow-left-circle fs-1 text-danger cursor-pointer d-block" @onclick="@NavigateBack"></i>
    <div class="card mx-auto my-4" style="max-width: 800px;">
        <div class="d-flex gap-4 justify-content-center my-2">
            <h1 class="fs-2 fw-bold">Fiche client de @Customer.FirstName @Customer.LastName</h1>
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-12 col-md-6">
                    <p class="mb-2"><strong>Nom de famille:</strong></p>
                    <p class="text-muted">@Customer.LastName</p>
                </div>
                <div class="col-12 col-md-6">
                    <p class="mb-2"><strong>Prénom:</strong></p>
                    <p class="text-muted">@Customer.FirstName</p>
                </div>
                <div class="col-12 col-md-6">
                    <p class="mb-2"><strong>Email:</strong></p>
                    <p class="text-muted">@Customer.Email</p>
                </div>
                <div class="col-12 col-md-6">
                    <p class="mb-2"><strong>Sexe de naissance:</strong></p>
                    <p class="text-muted">@Customer.GetGenderShort()</p>
                </div>
                <div class="col-12 col-md-6">
                    <p class="mb-2"><strong>Date de naissance:</strong></p>
                    <p class="text-muted">@Customer.BirthDate.ToString("dd/MM/yyyy")</p>
                </div>
                <div class="col-12 col-md-6">
                    <p class="mb-2"><strong>Âge:</strong></p>
                    <p class="text-muted">@Customer.GetAge() ans</p>
                </div>
            </div>
        </div>
        <div class="card-footer">
            <div class="d-flex justify-content-between">
                <div class="d-flex gap-3">
                    <button class="btn btn-primary fs-2" @onclick="@NavigateToProfile"><i
                            class="bi bi-person-bounding-box"></i></button>
                    <button class="btn btn-primary fs-2"><i class="bi bi-calendar2-week"></i></button>
                    <button class="btn btn-primary fs-2"><i class="bi bi-trophy-fill"></i></button>
                    <button class="btn btn-primary fs-2"><i class="bi bi-chat-left-fill"></i></button>

                </div>
                <div class="d-flex gap-3">
                    <button class="btn btn-primary fs-2"><i class="bi bi-pencil-square"></i></button>
                    <button class="btn btn-danger fs-2" @onclick="@DeletebButton"><i class="bi bi-trash"></i></button>
                </div>
            </div>
        </div>
    </div>
}