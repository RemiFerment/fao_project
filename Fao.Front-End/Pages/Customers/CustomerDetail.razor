@page "/customer/{CustomerUUID:guid}"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@attribute [Authorize(Roles = "ROLE_COACH")]

<div class="d-flex gap-4  my-4">
    <i class="bi bi-arrow-left-circle fs-1 text-danger" @onclick="@NavigateBack"></i>
    <h1>Détail du client</h1>
</div>
@if (IsLoading)
{
    <div class="text-center my-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}
else if (Customer == null)
{
    <div class="alert alert-danger" role="alert">
        Un problème est survenu lors du chargement des informations du client. Vérifier le lien ou réessayer plus tard.
    </div>
}
else
{
    <div class="card">
        <div class="card-body">
            <h3 class="card-title mb-3">@Customer.FirstName @Customer.LastName</h3>
            <div class="row g-3">
                <div class="col-12 col-md-6">
                    <p class="mb-2"><strong>Email:</strong></p>
                    <p class="text-muted">@Customer.Email</p>
                </div>
                <div class="col-12 col-md-6">
                    <p class="mb-2"><strong>Sexe de naissance:</strong></p>
                    <p class="text-muted">@Customer.GetGenderShort()</p>
                </div>
                <div class="col-12 col-md-6">
                    <p class="mb-2"><strong>Date de naissance:</strong></p>
                    <p class="text-muted">@Customer.BirthDate.ToString("dd/MM/yyyy")</p>
                </div>
                <div class="col-12 col-md-6">
                    <p class="mb-2"><strong>Âge:</strong></p>
                    <p class="text-muted">@Customer.GetAge() ans</p>
                </div>
            </div>
        </div>
        <div class="card-footer">
            <div class="d-flex justify-content-between">
                <div class="d-flex gap-3">
                    <button class="btn btn-primary fs-2" @onclick="@NavigateToProfile"><i
                            class="bi bi-person-bounding-box"></i></button>
                    <button class="btn btn-primary fs-2"><i class="bi bi-calendar2-week"></i></button>
                    <button class="btn btn-primary fs-2"><i class="bi bi-trophy-fill"></i></button>
                    <button class="btn btn-primary fs-2"><i class="bi bi-chat-left-fill"></i></button>

                </div>
                <div class="d-flex gap-3">
                    <button class="btn btn-primary fs-2"><i class="bi bi-pencil-square"></i></button>
                    <button class="btn btn-danger fs-2" @onclick="@DeletebButton"><i
                            class="bi bi-trash"></i></button>
                </div>
            </div>
        </div>
    </div>
}