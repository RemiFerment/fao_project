@page "/customers"
@inherits Fao.Front_End.Components.Pages.Customers.CustomersList
@using Fao.Front_End.Components.Customers
@using Fao.Front_End.Models
@using Fao.Front_End.Services
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "ROLE_COACH")]

<input type="text" class="form-control my-3" placeholder="Rechercher le client par nom ou prénom"
    @bind-value="SearchTerm" @bind-value:event="oninput" />
<div class="row g-3">
    <div class="col-12">
        @if (IsLoading)
        {
            <div class="text-center my-5">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
            </div>
        }
        else if (FilteredCustomers.Count() == 0)
        {
            <div class="alert alert-info" role="alert">
                Aucun client à afficher.
            </div>
        }
        else
        {
            @foreach (UserDTO customers in FilteredCustomers)
            {
                <CustomersListCard User="customers" />
            }
        }
    </div>
</div>